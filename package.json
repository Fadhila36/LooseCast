{
  "name": "loosecast",
  "productName": "LooseCast",
  "author": "fadhila36",
  "version": "1.0.1",
  "description": "LooseCast: Local System Casting Stream",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "dev": "electron . --dev",
    "test": "node --test tests/**/*.test.js",
    "bump": "node scripts/bump-version.js patch",
    "bump:minor": "node scripts/bump-version.js minor",
    "bump:major": "node scripts/bump-version.js major",
    "build": "electron-builder --win nsis portable",
    "build:installer": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "build:all": "electron-builder --win --mac --linux"
  },
  "dependencies": {
    "archiver": "^6.0.1",
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.3.0",
    "multer": "^1.4.5-lts.1",
    "obs-websocket-js": "^5.0.8",
    "socket.io": "^4.6.1",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "overrides": {
    "express": {
      "qs": "^6.16.0"
    }
  },
  "build": {
    "publish": {
      "provider": "github",
      "owner": "Fadhila36",
      "repo": "LooseCast"
    },
    "asarUnpack": [
      "**/server.js",
      "**/src/**",
      "node_modules/**",
      "**/public/**",
      "**/lang/**",
      "**/stream-kit-ui.js",
      "**/loosecast-ui.js"
    ],
    "appId": "com.loosecast.app",
    "productName": "LooseCast",
    "copyright": "Copyright © 2026 fadhila36",
    "icon": "build/icon.png",
    "files": [
      "electron/**/*",
      "public/**/*",
      "build/**/*",
      "server.js",
      "src/**/*",
      "lang/**/*",
      "stream-kit-ui.js",
      "loosecast-ui.js",
      "node_modules/**/*",
      "!node_modules/electron",
      "!node_modules/electron-builder",
      "!**/*.map",
      "!**/test*",
      "!**/spec*"
    ],
    "extraResources": [],
    "win": {
      "sign": null,
      "forceCodeSigning": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "LooseCast-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LooseCast",
      "displayLanguageSelector": false,
      "language": "1057"
    },
    "portable": {
      "artifactName": "LooseCast-Portable-${version}.${ext}"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    }
  }
}
