{
  "name": "loosecast",
  "productName": "LooseCast",
  "author": "fadhila36",
  "version": "1.1.3",
  "description": "LooseCast: Local System Casting Stream",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -k -s first \"node server.js\" \"wait-on -t 10000 http://localhost:3000 && tauri dev\"",
    "build": "tauri build",
    "test": "node --test",
    "tauri": "tauri",
    "tauri:dev": "concurrently -k -s first \"node server.js\" \"wait-on -t 10000 http://localhost:3000 && tauri dev\"",
    "tauri:build": "tauri build",
    "bump": "node scripts/bump-version.js patch",
    "bump:minor": "node scripts/bump-version.js minor",
    "bump:major": "node scripts/bump-version.js major"
  },
  "dependencies": {
    "archiver": "^6.0.1",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.3.0",
    "multer": "^1.4.5-lts.1",
    "obs-websocket-js": "^5.0.8",
    "socket.io": "^4.6.1",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "concurrently": "^10.0.5",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "express": {
      "qs": "^6.16.0"
    }
  }
}
