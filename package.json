{
  "name": "tomatosuki-stream-kit-aio",
  "productName": "Tomatosuki Stream kit AIO",
  "author": "fadhila36",
  "version": "0.0.1",
  "description": "Tomatosuki Stream Kit AIO — Meme overlay & deck controller untuk streamer",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "dev": "electron . --dev",
    "test": "node --test tests/**/*.test.js",
    "build": "electron-builder --win nsis portable",
    "build:installer": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "build:all": "electron-builder --win --mac --linux"
  },
  "dependencies": {
    "archiver": "^6.0.1",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.3.0",
    "multer": "^1.4.5-lts.1",
    "obs-websocket-js": "^5.0.8",
    "socket.io": "^4.6.1",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "asarUnpack": [
      "**/server.js",
      "**/src/**",
      "node_modules/**"
    ],
    "appId": "com.tomatosuki.streamkit",
    "productName": "Tomatosuki Stream Kit AIO",
    "copyright": "Copyright © 2026 fadhila36",
    "icon": "build/icon.png",
    "files": [
      "electron/**/*",
      "public/**/*",
      "build/**/*",
      "server.js",
      "src/**/*",
      "lang/**/*",
      "ksk-ui.js",
      "node_modules/**/*",
      "!node_modules/electron",
      "!node_modules/electron-builder",
      "!**/*.map",
      "!**/test*",
      "!**/spec*"
    ],
    "extraResources": [],
    "win": {
      "sign": null,
      "forceCodeSigning": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tomatosuki Stream Kit AIO",
      "displayLanguageSelector": false,
      "language": "1057"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    }
  }
}
