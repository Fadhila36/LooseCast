{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LooseCast",
  "version": "1.1.6",
  "identifier": "com.loosecast.app",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LooseCast",
        "url": "about:blank",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "visible": false
      },
      {
        "label": "splash",
        "title": "LooseCast Loading",
        "url": "splash.html",
        "width": 490,
        "height": 320,
        "decorations": false,
        "transparent": true,
        "center": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "../server.js",
      "../package.json",
      "../loosecast-ui.js",
      "../stream-kit-ui.js",
      "../public/**/*",
      "../lang/**/*",
      "../src/**/*",
      "../node_modules/**/*"
    ],
    "externalBin": [
      "bin/loosecast-server"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {}
}
